ADVERTISE_IP=
CHANGE_CONFIG_DIR_OWNERSHIP=true
#PLEX_UID=1001
#PLEX_GID=1001
# PLEX_CLAIM is a single use expiring token, set this when initializing a
# fresh server & unset after first run completes.
# https://www.plex.tv/claim
#
# Note: in the case of a password reset, delete the `PlexOnlineToken`
# attribute from Preferences.xml then restart with a new PLEX_CLAIM token.
#
#PLEX_CLAIM=
